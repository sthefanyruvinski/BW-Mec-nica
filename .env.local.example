# Connection string do Postgres (Vercel Storage -> Postgres/Neon)
DATABASE_URL=

# Gere com: npm run hash-password -- "sua-senha-aqui"
# Importante: o Next.js expande "$" em arquivos .env, então troque cada "$" do hash por "\$"
# (ex: $2b$10$abc... vira \$2b\$10\$abc...)
ADMIN_PASSWORD_HASH=

# Gere com: openssl rand -base64 32
AUTH_SECRET=

# Vercel Storage -> Blob (gerado automaticamente ao conectar o Blob store ao projeto)
BLOB_READ_WRITE_TOKEN=
